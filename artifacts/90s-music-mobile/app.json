{
  "expo": {
    "name": "PlayTune",
    "slug": "90s-music-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "90s-music-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0a09"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.priyajeet.musicapp"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      ["expo-audio", { "enableBackgroundPlayback": true }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e35184c3-2675-41ec-8b64-0d57ac258d11"
      }
    }
  }
}
